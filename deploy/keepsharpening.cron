# Installed to /etc/cron.d/keepsharpening by setup-droplet.sh.
# Rebuild daily so the "last month" section on the home page stays current
# (it is computed at build time). Also picks up any pushed changes.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

15 4 * * * keepsharpening /opt/keepsharpening/deploy/deploy.sh >> /var/log/keepsharpening/deploy.log 2>&1
