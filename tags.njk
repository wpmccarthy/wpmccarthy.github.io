---
layout: base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag.slug }}/"
eleventyComputed:
  title: "Tagged “{{ tag.name }}”"
---
{% from "post-meta.njk" import postMeta %}
<h1>Tagged “{{ tag.name }}”</h1>
{% if tag.definition %}<p class="tag-definition">{{ tag.definition }}</p>{% endif %}
<ul class="post-list">
  {% for post in tag.notes %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    {{ postMeta(post.data.date, post.data.type, post.data.tags) }}
  </li>
  {% endfor %}
</ul>
